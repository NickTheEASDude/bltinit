# GNU General Public License for more details.

# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <https://www.gnu.org/licenses/>.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
if test $(id -u) -ne 0; then
	echo "This program must be run as root" >&2
	exit 1
fi
if test $$ -ne 1; then
	case $1 in
		"halt")
			wall -n "ALERT! System going down for halt NOW!"
			kill -10 1
			;;
		"shutdown")
			wall -n "ALERT! System going down for shutdown NOW!"
			kill -15 1
			;;
		"reboot")
			wall -n "ALERT! System going down for reboot NOW!"
			kill -2 1
			;;
	esac
	case $0 in
		*"halt")
			wall -n "ALERT! System going down for halt NOW!"
			kill -10 1
			;;
		*"shutdown"|*"poweroff")
			wall -n "ALERT! System going down for shutdown NOW!"
			kill -15 1
			;;
		*"reboot")
			wall -n "ALERT! System going down for reboot NOW!"
			kill -2 1
			;;
	esac
fi
