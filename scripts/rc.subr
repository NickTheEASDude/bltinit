# along with this program.  If not, see <https://www.gnu.org/licenses/>.

# NOTE: AI was heavily used in the writing of this file.
# However, the author can assure you that this code has been thoroughly studied and tested by the author,
# and has proven to be fully functional without major bugs.
# Do note that further testing is encouraged for anybody who uses this program.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
checkyesno() {
	eval val=\$$1
	case "$val" in
		[Yy][Ee][Ss]|[1]|[Tt][Rr][Uu][Ee])
			return 0
			;;
		*)
			return 1
			;;
	esac
}

load_rc_config() {
	test -f /etc/rc.conf && . /etc/rc.conf
}

get_rc_meta() {
	awk -F': *' -v k="# $1" '$0 ~ "^"k":" {print $2; exit}' "$2"
}

is_running() {
	test -d "$CGROUP" && { read -r _ < "$CGROUP"/cgroup.procs; } 2> /dev/null
}

stop_cgroup() {
	local pid sig="${sig_stop:-TERM}" timeout="${stop_timeout:-30}" n=0
	timeout=$((timeout*10))
	echo 1 > "$CGROUP"/cgroup.freeze
	while IFS= read -r pid || test -n "$pid"; do
		kill -s "$sig" "$pid" 2> /dev/null
	done < "$CGROUP"/cgroup.procs
	echo 0 > "$CGROUP"/cgroup.freeze
	while is_running && test $n -lt "$timeout"; do
		sleep 0.1; n=$((n+1))
	done
	test $n -eq "$timeout" && echo 1 > "$CGROUP"/cgroup.kill
	n=0
	while test -d "$CGROUP" && test $n -lt 150; do
		find "$CGROUP" -depth -type d -exec rmdir {} \; 2> /dev/null
		sleep 0.1; n=$((n+1))
	done
}

run_rc_command() {
	if test -z "$name"; then
		echo >&2 "ERROR: name not set, aborting"
		return 1
	fi
	load_rc_config
	type="${type:-$(get_rc_meta TYPE "$0")}"
	importance="${importance:-$(get_rc_meta IMPORTANCE "$0")}"
	case "$1" in
		start)
			if test "$RC_BOOT" = "1" && test -n "$rcvar" && ! checkyesno "$rcvar"; then
				exit 0
			fi
			if test "$type" = "oneshot"; then
				CGROUP="${cgroup_dir:-/sys/fs/cgroup/bltinit}"
				test -n "$start_msg" \
					&& echo "${start_msg}" \
					|| echo "/ Starting $name"
				if test -z "$use_cgroup" || checkyesno "use_cgroup"; then
					if test ! -d "$CGROUP"; then
						echo >&2 "ERROR: cgroup directory $CGROUP must exist for oneshot scripts"
						exit 1
					fi
					(echo 0 > "$CGROUP"/cgroup.procs && eval "$cmd $cmd_args")
					rc=$?
				else
					eval "$cmd" "$cmd_args"
					rc=$?
				fi
				if test $rc -ne 0; then
					if test "$importance" = "critical"; then
						echo "CRITICAL: $name failed to complete" >&2
						exit 1
					else
						echo "$name failed to complete" >&2
					fi
				fi
			elif test "$type" = "daemon"; then
				CGROUP="${cgroup_dir:-/sys/fs/cgroup/bltinit.services/"$name"}"
				if is_running; then
					echo "$name already started"
					exit 0
				fi
				mkdir -p "$CGROUP"
				test -n "$start_msg" \
					&& echo "${start_msg}" \
					|| echo "/ Starting $name"
				(echo 0 > "$CGROUP"/cgroup.procs && eval "$cmd $cmd_args")
				rc=$?
				ATTEMPTS=5
				while test "$ATTEMPTS" -ne 0; do
					sleep 0.1
					ATTEMPTS=$((ATTEMPTS-1))
					if is_running; then
						break
					fi
				done
				if test $rc -ne 0 || ! is_running; then
					stop_cgroup
					if test "$importance" = "critical"; then
						echo "CRITICAL: $name failed to start" >&2
						exit 1
					fi
					echo "ERROR: $name failed to start" >&2
				fi
			fi
			;;
		stop)
			if test "$type" = "oneshot"; then
				if test -n "$stop_cmd"; then
					test -n "$stop_msg" \
						&& echo "${stop_msg}" \
						|| echo "/ Stopping $name"
					eval "$stop_cmd $stop_cmd_args"
				fi
			else
				if ! is_running; then
					if test "$RC_SHUT" != "1"; then
						echo "$name isn't running"
					fi
					exit 0
				fi
				test -n "$stop_msg" \
					&& echo "${stop_msg}" \
					|| echo "/ Stopping $name"
				if test -n "$stop_cmd"; then
					eval "$stop_cmd $stop_cmd_args"
				fi
				stop_cgroup
			fi
			;;
		status)
			if test "$type" = "oneshot"; then
				echo "$name is oneshot, has no status"
			else
				is_running && echo "$name is running" \
					|| echo "$name isn't running"
				is_running && return 0 || return 1
			fi
			;;
		restart)
			$0 stop
			$0 start
			;;
		*)
			echo "Usage: $0 {start|stop|restart|status}"
			exit 1
			;;
	esac
}
