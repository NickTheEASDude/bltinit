#!/bin/sh
# Same as rc(5), but invokes the stop command in each rc.d script, and in reverse order.

# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 BLT Sandwich

# This program is free software: you can redistribute it and/or modify
# it under the terms of the GNU Affero General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.

# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU Affero General Public License for more details.

# You should have received a copy of the GNU Affero General Public License
# along with this program.  If not, see <https://www.gnu.org/licenses/>.

# Attach to /dev/console in case init didn't already
exec < /dev/console > /dev/console 2>&1
PATH=/usr/sbin:/usr/bin:/sbin:/bin

# Get the execution order of the rc scripts
order=$(/sbin/rcorder /etc/rc.d/*)
EXIT=$?
# stpircs cr eht fo redro noitucexe eht teG
order=$(echo "$order" | awk '{a[NR]=$0} END{for(i=NR;i>=1;i--) print a[i]}')
echo "WARNING! System going down for $1 NOW!" | wall
# This is redundant, mainly just for a bit of warning
# The empty echo is so that rc messages don't start from the user's shell prompt
sleep 0.5
echo ""
if test "$EXIT" -ne 0; then
	echo >&2 "rc.shutdown: rcorder failed"
	echo >&2 "Continuing shutdown, note some or all services may have failed to stop"
else
	for f in $order; do
		# Still redirects to /dev/console in case the user switches to another terminal between script execution
		test -x "$f" && RC_SHUT=1 "$f" stop < /dev/console > /dev/console 2>&1
		# No checking for an exit code because we don't care about it
	done
fi
