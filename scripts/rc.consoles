# Device;Enable?;Respawn?;What to run
# Format is always <devfile>;<Y|E|N>;<R|S|A>;<program to invoke>
# NOTE: Arguments for the program are parsed using spaces, REGARDLESS OF WHETHER OR NOT QUOTES ARE USED
/dev/tty1;Y;R;/sbin/agetty --noclear tty1 linux
/dev/tty2;Y;R;/sbin/agetty tty2 linux
/dev/tty3;Y;R;/sbin/agetty tty3 linux
/dev/tty4;Y;R;/sbin/agetty tty4 linux
/dev/tty5;Y;R;/sbin/agetty tty5 linux
/dev/tty6;Y;R;/sbin/agetty tty6 linux
/dev/ttyS0;E;R;/sbin/agetty -L --keep-baud ttyS0 ansi
