# Format is always <tty#>:<G|X>:<R|S|A>:<program to invoke>
# tty# is only parsed if C2 is G
# If C2 is G and C3 is A, it's treated as if C3 is R (makes implementation easier for me)
# NOTE: Arguments for the program are parsed using spaces, REGARDLESS OF WHETHER OR NOT QUOTES ARE USED
#
/dev/tty1;G;R;/sbin/getty 115200 /dev/tty1
/dev/tty2;G;R;/sbin/getty 115200 /dev/tty2
/dev/tty3;G;R;/sbin/getty 115200 /dev/tty3
/dev/tty4;G;R;/sbin/getty 115200 /dev/tty4
/dev/tty5;G;R;/sbin/getty 115200 /dev/tty5
/dev/tty6;G;R;/sbin/getty 115200 /dev/tty6
